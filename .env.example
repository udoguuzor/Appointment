# Server Configuration
PORT=3000

# Database Configuration
# Replace username, password, localhost, and database_name with your actual PostgreSQL credentials.
DATABASE_URL="mongodb://localhost:27017/BookingDB"

# JWT Authentication Secrets
# You can generate strong secrets using node: `require('crypto').randomBytes(64).toString('hex')`
ACCESS_TOKEN_SECRET="your_super_secret_access_token_string"
REFRESH_TOKEN_SECRET="your_super_secret_refresh_token_string"

# Email Configuration (Nodemailer)
# Standard SMTP settings. By default, you can use Ethereal Email for testing, or SendGrid/Gmail for production.
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your_email_username"
SMTP_PASS="your_email_password"
